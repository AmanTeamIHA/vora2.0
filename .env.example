# Local development only. Copy to .env if you run the API outside Docker.
# Production secrets stay in AWS Secrets Manager. Do not put real keys here.

# local and dev allow password-only sign-in. prod refuses it.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://vora:vora@localhost:5432/vora
APP_DATABASE_URL=postgresql+psycopg://vora_app:vora@localhost:5432/vora
ADMIN_DATABASE_URL=postgresql+psycopg://vora_admin:vora@localhost:5432/vora
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://127.0.0.1:8000
# Local only. Production JWT secret comes from Secrets Manager.
JWT_SECRET=local-dev-jwt-secret-not-for-production
# Used by `python -m vora_api.bootstrap_owner`. Do not commit real values.
# OWNER_EMAIL=
# OWNER_PASSWORD=
